<Window x:Class="Arrival.Test.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мессенджер" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">
    <Window.Resources>
        <!-- Цвета светлой темы (в стиле Telegram) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="ChatListBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ChatItemBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ChatItemHoverBackground" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="ChatItemSelectedBackground" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MessageAreaBackground" Color="#E5DDD5"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputForeground" Color="#000000"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MainText" Color="#000000"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#707579"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2481CC"/>
        <SolidColorBrush x:Key="MyMessageBackground" Color="#EEFFDE"/>
        <SolidColorBrush x:Key="OtherMessageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnlineStatusColor" Color="#4CAF50"/>
        
        <!-- Цвета темной темы -->
        <SolidColorBrush x:Key="DarkWindowBackground" Color="#0f0f0f"/>
        <SolidColorBrush x:Key="DarkChatListBackground" Color="#212121"/>
        <SolidColorBrush x:Key="DarkChatItemBackground" Color="#212121"/>
        <SolidColorBrush x:Key="DarkChatItemHoverBackground" Color="#2c2c2c"/>
        <SolidColorBrush x:Key="DarkChatItemSelectedBackground" Color="#2b5278"/>
        <SolidColorBrush x:Key="DarkMessageAreaBackground" Color="#0f0f0f"/>
        <SolidColorBrush x:Key="DarkInputBackground" Color="#212121"/>
        <SolidColorBrush x:Key="DarkInputForeground" Color="#ffffff"/>
        <SolidColorBrush x:Key="DarkInputBorder" Color="#3a3a3a"/>
        <SolidColorBrush x:Key="DarkMainText" Color="#ffffff"/>
        <SolidColorBrush x:Key="DarkSecondaryText" Color="#aaaaaa"/>
        <SolidColorBrush x:Key="DarkMyMessageBackground" Color="#2b5278"/>
        <SolidColorBrush x:Key="DarkOtherMessageBackground" Color="#212121"/>
        
        <!-- Стили для кнопок -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="50"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F4F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1970B3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стили для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <!-- Стиль для ListBox (список чатов) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainText}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Margin="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ChatItemHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ChatItemSelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Конвертер для цвета имени отправителя -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid x:Name="MainGrid" Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="250" MaxWidth="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Левая панель - Список чатов/пользователей -->
        <Border Grid.Column="0" Background="{DynamicResource ChatListBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок левой панели -->
                <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource ChatListBackground}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Мессенджер" FontSize="20" FontWeight="Bold" 
                                       Foreground="{DynamicResource MainText}"/>
                            <TextBlock x:Name="CurrentUserTextBlock" FontSize="12" 
                                       Foreground="{DynamicResource SecondaryText}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" x:Name="ThemeToggleButton" Content="🌙" 
                                Style="{StaticResource IconButton}"
                                Click="ThemeToggleButton_Click"
                                ToolTip="Переключить тему"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="LogoutButton" Content="🚪" 
                                Style="{StaticResource IconButton}"
                                Click="LogoutButton_Click"
                                ToolTip="Выйти"/>
                    </Grid>
                </Border>
                
                <!-- Поиск по контактам -->
                <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource ChatListBackground}">
                    <TextBox x:Name="SearchTextBox" 
                             TextChanged="SearchTextBox_TextChanged"
                             FontSize="13">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{DynamicResource InputBackground}" 
                                        CornerRadius="20"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,8,0"
                                                   FontSize="14"/>
                                        <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>
                
                <!-- Список пользователей/чатов -->
                <Border Grid.Row="2" Background="{DynamicResource ChatListBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="ЧАТЫ" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource SecondaryText}"
                                   Padding="16,8,16,4"/>
                        
                        <ListBox x:Name="ChatListBox" Grid.Row="1"
                                 SelectionChanged="ChatListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Аватарка -->
                                        <Border Grid.Column="0" Width="48" Height="48" 
                                                CornerRadius="24"
                                                Background="{DynamicResource AccentColor}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding AvatarText}" 
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Информация о чате -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Username}" 
                                                           FontSize="15" FontWeight="Semibold"
                                                           Foreground="{DynamicResource MainText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding LastTime}" 
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Ellipse Grid.Column="0" Width="8" Height="8" 
                                                         Fill="{DynamicResource OnlineStatusColor}"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                                         Margin="0,0,6,0"/>
                                                        
                                                <TextBlock Grid.Column="1" Text="{Binding LastMessagePreview}" 
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                
                <!-- Кнопка обновления списка -->
                <Border Grid.Row="3" Padding="12,8" Background="{DynamicResource ChatListBackground}">
                    <Button x:Name="RefreshUsersButton" Content="⟳ Обновить список" 
                            Click="RefreshUsersButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>
        
        <!-- Правая панель - Область переписки -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок чата -->
            <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource ChatListBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Аватарка текущего чата -->
                    <Border Grid.Column="0" Width="40" Height="40" 
                            CornerRadius="20"
                            Background="{DynamicResource AccentColor}"
                            Margin="0,0,12,0">
                        <TextBlock x:Name="CurrentChatAvatarText" Text="" 
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Информация о чате -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentChatNameText" FontSize="16" FontWeight="Semibold" 
                                   Foreground="{DynamicResource MainText}"/>
                        <TextBlock x:Name="CurrentChatStatusText" FontSize="12" 
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                    
                    <!-- Кнопки действий -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="WebSocketConnectButton" Content="🔔" 
                                Style="{StaticResource IconButton}"
                                Click="WebSocketConnectButton_Click"
                                ToolTip="Подключить уведомления"/>
                        <Button x:Name="WebSocketDisconnectButton" Content="🔕" 
                                Style="{StaticResource IconButton}"
                                Click="WebSocketDisconnectButton_Click"
                                ToolTip="Отключить уведомления"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Область сообщений -->
            <Border Grid.Row="1" x:Name="MessagesBorder" 
                    Background="{DynamicResource MessageAreaBackground}">
                <ScrollViewer x:Name="MessagesScrollViewer" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <ItemsControl x:Name="MessagesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" HorizontalAlignment="{Binding Alignment}"
                                        MaxWidth="500">
                                    <StackPanel>
                                        <Border Background="{Binding MessageBackground}" 
                                                CornerRadius="12"
                                                Padding="12,8"
                                                Margin="0,0,0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderName}" 
                                                           FontSize="12" 
                                                           FontWeight="Semibold"
                                                           Foreground="#AAAAAA"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding ShowSender}"/>
                                                <TextBlock Text="{Binding Content}" 
                                                           FontSize="14" 
                                                           Foreground="White"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding TimeText}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   HorizontalAlignment="{Binding TimeAlignment}"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <!-- Область ввода сообщения -->
            <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource ChatListBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="MessageInputTextBox" Grid.Column="0"
                             KeyDown="MessageInputTextBox_KeyDown"
                             FontSize="14"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{DynamicResource InputBackground}" 
                                        CornerRadius="20"
                                        Padding="16,10">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    
                    <Button Grid.Column="1" x:Name="SendButton" Content="➤" 
                            Style="{StaticResource IconButton}"
                            Click="SendButton_Click"
                            Margin="12,0,0,0"
                            ToolTip="Отправить сообщение"
                            FontSize="18"
                            Padding="12"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Экран авторизации (оверлей) -->
        <Grid x:Name="AuthOverlay" 
              Background="{DynamicResource WindowBackground}"
              Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource ChatListBackground}"
                    CornerRadius="16"
                    Padding="32"
                    MinWidth="350">
                <StackPanel>
                    <TextBlock Text="Добро пожаловать" FontSize="24" FontWeight="Bold" 
                               Foreground="{DynamicResource MainText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>
                    
                    <!-- Вкладка входа -->
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Вход в систему" FontSize="18" FontWeight="Semibold" 
                                   Foreground="{DynamicResource MainText}"
                                   Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Логин" FontSize="13" 
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="LoginUsernameTextBox" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Пароль" FontSize="13" 
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,4"/>
                        <PasswordBox x:Name="LoginPasswordBox" Margin="0,0,0,16"/>
                        
                        <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                                Click="LoginButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"/>
                        
                        <Button Content="Нет аккаунта? Зарегистрироваться" 
                                Background="Transparent"
                                Foreground="{DynamicResource AccentColor}"
                                BorderThickness="0"
                                Padding="8"
                                Cursor="Hand"
                                Click="ShowRegisterButton_Click"/>
                        
                        <TextBlock x:Name="LoginMessageTextBlock" 
                                   Foreground="#FF6B6B"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                    
                    <!-- Вкладка регистрации -->
                    <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                        <TextBlock Text="Регистрация" FontSize="18" FontWeight="Semibold" 
                                   Foreground="{DynamicResource MainText}"
                                   Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Логин" FontSize="13" 
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="RegisterUsernameTextBox" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Пароль" FontSize="13" 
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,4"/>
                        <PasswordBox x:Name="RegisterPasswordBox" Margin="0,0,0,16"/>
                        
                        <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}"
                                Click="RegisterButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"/>
                        
                        <Button Content="Есть аккаунт? Войти" 
                                Background="Transparent"
                                Foreground="{DynamicResource AccentColor}"
                                BorderThickness="0"
                                Padding="8"
                                Cursor="Hand"
                                Click="ShowLoginButton_Click"/>
                        
                        <TextBlock x:Name="AuthMessageTextBlock" 
                                   Foreground="#FF6B6B"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
