<Window x:Class="Arrival.Test.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger WPF Client" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status -->
        <Border Grid.Row="0" Background="#E0E0E0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" FontSize="14" FontWeight="Bold" Text="Не авторизован"/>
                <TextBlock x:Name="UserInfoTextBlock" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <!-- Auth Tab -->
            <TabItem x:Name="AuthTabItem" Header="Авторизация">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Регистрация" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Логин:" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="RegisterUsernameTextBox" Width="200"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Пароль:" VerticalAlignment="Center" Width="80"/>
                        <PasswordBox x:Name="RegisterPasswordBox" Width="200"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RegisterButton" Content="Зарегистрироваться" Click="RegisterButton_Click"/>
                        <Button x:Name="LoginShowButton" Content="Войти" Click="LoginShowButton_Click"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="4" x:Name="AuthMessageTextBlock" Margin="0,10,0,0" Foreground="Red" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- Login Tab (hidden after login) -->
            <TabItem x:Name="LoginTabItem" Header="Вход">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Логин:" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="LoginUsernameTextBox" Width="200"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Пароль:" VerticalAlignment="Center" Width="80"/>
                        <PasswordBox x:Name="LoginPasswordBox" Width="200"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click"/>
                        <Button x:Name="BackToRegisterButton" Content="Назад к регистрации" Click="BackToRegisterButton_Click"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="3" x:Name="LoginMessageTextBlock" Margin="0,10,0,0" Foreground="Red" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- Messages Tab -->
            <TabItem x:Name="MessagesTabItem" Header="Сообщения" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Send Message Panel -->
                    <Border Grid.Row="0" BorderBrush="#CCC" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Получатель:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecipientTextBox" Margin="0,0,0,5" 
                                     ToolTip="Оставьте пустым для общего чата или введите логин получателя"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Сообщение:" VerticalAlignment="Center" Margin="0,5,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MessageTextBox" Margin="0,5,0,0" Height="60" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            
                            <Button Grid.Row="1" Grid.Column="2" x:Name="SendButton" Content="Отправить" 
                                    Click="SendButton_Click" VerticalAlignment="Bottom" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Messages List -->
                    <ListBox x:Name="MessagesListBox" Grid.Row="1" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"/>

                    <!-- Refresh Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button x:Name="RefreshMessagesButton" Content="Обновить сообщения" Click="RefreshMessagesButton_Click"/>
                        <TextBlock x:Name="MessagesStatusTextBlock" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Users Tab -->
            <TabItem x:Name="UsersTabItem" Header="Пользователи" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="RefreshUsersButton" Content="Обновить список" 
                            Click="RefreshUsersButton_Click" HorizontalAlignment="Left"/>
                    
                    <ListBox x:Name="UsersListBox" Grid.Row="1" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="40"/>
                                    <TextBlock Text="{Binding Username}" Width="150"/>
                                    <TextBlock Text="{Binding Status}" Width="100"/>
                                    <TextBlock Text="{Binding Role}" Width="80"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- WebSocket Status Tab -->
            <TabItem x:Name="WebSocketTabItem" Header="WebSocket" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <TextBlock x:Name="WebSocketStatusTextBlock" FontSize="14" FontWeight="Bold" Text="Статус: Не подключено"/>
                        <TextBlock x:Name="WebSocketInfoTextBlock" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ConnectWebSocketButton" Content="Подключиться" Click="ConnectWebSocketButton_Click"/>
                        <Button x:Name="DisconnectWebSocketButton" Content="Отключиться" Click="DisconnectWebSocketButton_Click"/>
                    </StackPanel>

                    <ListBox x:Name="RealTimeMessagesListBox" Grid.Row="2" Margin="0,10,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer / Logout -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="LogoutButton" Content="Выйти из аккаунта" Click="LogoutButton_Click" Visibility="Collapsed"/>
            <Button x:Name="ExitButton" Content="Выход" Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
