<Window x:Class="Arrival.Test.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger WPF Client" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Базовый стиль для кнопок футера - общие геометрические свойства -->
        <Style x:Key="BaseFooterButton" TargetType="Button">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>
        
        <!-- Нейтральная кнопка (переключатель темы) -->
        <Style x:Key="NeutralFooterButton" TargetType="Button" BasedOn="{StaticResource BaseFooterButton}">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5A5A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Outline-кнопка (вторичное действие - выход из аккаунта) -->
        <Style x:Key="OutlineFooterButton" TargetType="Button" BasedOn="{StaticResource BaseFooterButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A007ACC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Danger-кнопка (деструктивное действие - выход из приложения) -->
        <Style x:Key="DangerFooterButton" TargetType="Button" BasedOn="{StaticResource BaseFooterButton}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A93226"/>
                    <Setter Property="BorderBrush" Value="#A93226"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#922B21"/>
                    <Setter Property="BorderBrush" Value="#922B21"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Стили для TabControl и TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" 
                                BorderThickness="0"
                                CornerRadius="3,3,0,0"
                                Margin="0,0,0,-1">
                            <ContentPresenter x:Name="ContentSite" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="#F1F1F1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3C3C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <!-- Стили для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Стили для PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Стили для ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Стили для TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>
        
        <!-- Стили для Border -->
        <Style TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Status -->
        <Border Grid.Row="0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" FontSize="14" FontWeight="Bold" Text="Не авторизован"/>
                <TextBlock x:Name="UserInfoTextBlock" FontSize="12" Foreground="#CCCCCC"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <!-- Auth Tab -->
            <TabItem x:Name="AuthTabItem" Header="Авторизация">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Регистрация" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Логин:" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="RegisterUsernameTextBox" Width="200" KeyDown="RegisterUsername_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Пароль:" VerticalAlignment="Center" Width="80"/>
                        <PasswordBox x:Name="RegisterPasswordBox" Width="200" KeyDown="RegisterPassword_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RegisterButton" Content="Зарегистрироваться" Click="RegisterButton_Click"/>
                        <Button x:Name="LoginShowButton" Content="Войти" Click="LoginShowButton_Click"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="4" x:Name="AuthMessageTextBlock" Margin="0,10,0,0" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- Login Tab (hidden after login) -->
            <TabItem x:Name="LoginTabItem" Header="Вход">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Логин:" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="LoginUsernameTextBox" Width="200" KeyDown="LoginUsername_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Пароль:" VerticalAlignment="Center" Width="80"/>
                        <PasswordBox x:Name="LoginPasswordBox" Width="200" KeyDown="LoginPassword_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click"/>
                        <Button x:Name="BackToRegisterButton" Content="Назад к регистрации" Click="BackToRegisterButton_Click"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="3" x:Name="LoginMessageTextBlock" Margin="0,10,0,0" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- Messages Tab -->
            <TabItem x:Name="MessagesTabItem" Header="Сообщения" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Send Message Panel -->
                    <Border Grid.Row="0" BorderBrush="#3E3E42" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Получатель:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecipientTextBox" Margin="0,0,0,5" 
                                     ToolTip="Оставьте пустым для общего чата или введите логин получателя"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Сообщение:" VerticalAlignment="Center" Margin="0,5,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MessageTextBox" Margin="0,5,0,0" Height="60" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     KeyDown="MessageTextBox_KeyDown"/>
                            
                            <Button Grid.Row="1" Grid.Column="2" x:Name="SendButton" Content="Отправить" 
                                    Click="SendButton_Click" VerticalAlignment="Bottom" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Messages Display -->
                    <TextBox x:Name="MessagesTextBox" Grid.Row="1" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             Padding="5"
                             AcceptsReturn="True"/>

                    <!-- Refresh Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button x:Name="RefreshMessagesButton" Content="Обновить сообщения" Click="RefreshMessagesButton_Click"/>
                        <TextBlock x:Name="MessagesStatusTextBlock" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Users Tab -->
            <TabItem x:Name="UsersTabItem" Header="Пользователи" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="RefreshUsersButton" Content="Обновить список" 
                            Click="RefreshUsersButton_Click" HorizontalAlignment="Left"/>
                    
                    <ListBox x:Name="UsersListBox" Grid.Row="1" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="40"/>
                                    <TextBlock Text="{Binding Username}" Width="150"/>
                                    <TextBlock Text="{Binding Status}" Width="100"/>
                                    <TextBlock Text="{Binding Role}" Width="80"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- WebSocket Status Tab -->
            <TabItem x:Name="WebSocketTabItem" Header="WebSocket" IsEnabled="False">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <TextBlock x:Name="WebSocketStatusTextBlock" FontSize="14" FontWeight="Bold" Text="Статус: Не подключено"/>
                        <TextBlock x:Name="WebSocketInfoTextBlock" FontSize="12" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ConnectWebSocketButton" Content="Подключиться" Click="ConnectWebSocketButton_Click"/>
                        <Button x:Name="DisconnectWebSocketButton" Content="Отключиться" Click="DisconnectWebSocketButton_Click"/>
                    </StackPanel>

                    <ListBox x:Name="RealTimeMessagesListBox" Grid.Row="2" Margin="0,10,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer / Logout -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="LogoutButton" Content="Выйти из аккаунта" Click="LogoutButton_Click" Visibility="Collapsed" Style="{StaticResource OutlineFooterButton}"/>
            <Button x:Name="ThemeToggleButton" Content="☀ Светлая" Style="{StaticResource NeutralFooterButton}" Click="ThemeToggleButton_Click"/>
            <Button x:Name="ExitButton" Content="Выход" Click="ExitButton_Click" Style="{StaticResource DangerFooterButton}"/>
        </StackPanel>
    </Grid>
</Window>
