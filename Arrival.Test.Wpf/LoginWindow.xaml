<Window x:Class="Arrival.Test.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мессенджер - Вход" 
        Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- Тени -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        
        <!-- Анимация появления -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Border Background="#FFFFFF" CornerRadius="16" Effect="{StaticResource WindowShadow}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок окна (для перетаскивания) -->
            <Border Grid.Row="0" Background="#2481CC" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="20,15">
                        <TextBlock Text="✈ Мессенджер" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Вход в аккаунт" FontSize="12" Foreground="#E3F2FD" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="✕" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="14" Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C62828"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Контент -->
            <Grid Grid.Row="1" Margin="40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Логотип -->
                <Border Grid.Row="0" Width="80" Height="80" CornerRadius="40" Background="#2481CC" 
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="✈" FontSize="40" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Заголовок -->
                <TextBlock Grid.Row="1" Text="Добро пожаловать!" FontSize="22" FontWeight="Bold" 
                           Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                
                <TextBlock Grid.Row="2" Text="Войдите или зарегистрируйтесь" FontSize="13" 
                           Foreground="#707579" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                    <!-- Панель входа -->
                <StackPanel Grid.Row="3" x:Name="LoginPanel">
                    <TextBlock Text="Имя пользователя" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#555555" Margin="0,0,0,8"/>
                    <Border Background="#F5F5F5" CornerRadius="10" Padding="15,12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="👤" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="LoginUsernameTextBox" 
                                     BorderThickness="0" Background="Transparent" FontSize="14"
                                     TextChanged="LoginUsername_TextChanged"
                                     KeyDown="LoginUsername_KeyDown"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="Пароль" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#555555" Margin="0,0,0,8"/>
                    <Border Background="#F5F5F5" CornerRadius="10" Padding="15,12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <PasswordBox Grid.Column="1" x:Name="LoginPasswordBox" 
                                         BorderThickness="0" Background="Transparent" FontSize="14"
                                         PasswordChar="•"
                                         KeyDown="LoginPassword_KeyDown"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock x:Name="LoginMessageTextBlock" FontSize="12" 
                               Foreground="#F44336" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    
                    <Button Content="Войти" Click="LoginButton_Click" 
                            Background="#2481CC" Foreground="White" BorderThickness="0"
                            Padding="0,14" FontSize="15" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1970B3"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#15609D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button x:Name="RegisterButton" Content="➤ НЕТ АККАУНТА? ЗАРЕГИСТРИРОВАТЬСЯ" Click="ShowRegisterButton_Click"
                            Background="#FF5722" Foreground="White" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand" Padding="0,12" Margin="0,15,0,20">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F4511E"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#E64A19"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <!-- Индикатор загрузки -->
                <Border Grid.Row="4" x:Name="LoadingBorder" Visibility="Collapsed" 
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" 
                                 Background="#E0E0E0" Foreground="#2481CC"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
