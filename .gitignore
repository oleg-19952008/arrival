```gitignore
# Build artifacts
bin/
obj/
*.dll
*.exe
*.pdb
*.so
*.dylib

# Dependencies
packages/
node_modules/
.nuget/

# Logs
*.log
logs/

# Environment
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vs/
.idea/
*.swp
*.swo

# Test and coverage
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
```