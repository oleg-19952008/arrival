```gitignore
# Compiled and binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj
*.out
*.pyc
*.pyo
*.jar
*.war
*.zip
*.tar.gz
*.tar.xz
*.tar.bz2

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/
dist/
build/
target/
.gradle/
julia-*/
zig*/

# Environment
.env
.env.local
.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System files
.DS_Store
Thumbs.db

# Logs
*.log
```