@page "/"
@using Messenger.Admin.Web.Services
@inject ApiService ApiService

<PageTitle>Админ панель</PageTitle>

<div class="admin-container">
    <h1>Панель администратора</h1>
    
    <div class="section">
        <h2>Пользователи</h2>
        
        @if (users == null)
        {
            <p>Загрузка...</p>
        }
        else if (!users.Any())
        {
            <p>Нет пользователей</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Имя</th>
                        <th>Роль</th>
                        <th>Статус</th>
                        <th>Дата создания</th>
                        <th>Последний вход</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Username</td>
                            <td>@user.Role</td>
                            <td>
                                <span class="status-@user.Status.ToLower()">@user.Status</span>
                            </td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (user.Status == "Pending")
                                {
                                    <button class="btn btn-success btn-sm" @onclick="(() => ApproveUser(user.Id))">
                                        Одобрить
                                    </button>
                                }
                                @if (user.Status != "Blocked")
                                {
                                    <button class="btn btn-warning btn-sm" @onclick="(() => BlockUser(user.Id))">
                                        Заблокировать
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-info btn-sm" @onclick="(() => UnblockUser(user.Id))">
                                        Разблокировать
                                    </button>
                                }
                                <button class="btn btn-danger btn-sm" @onclick="(() => DeleteUser(user.Id))">
                                    Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="section">
        <h2>Сообщения</h2>
        
        @if (messages == null)
        {
            <p>Загрузка...</p>
        }
        else if (!messages.Any())
        {
            <p>Нет сообщений</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Отправитель</th>
                        <th>Тип</th>
                        <th>Содержимое</th>
                        <th>Дата</th>
                        <th>Удалено</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in messages)
                    {
                        <tr>
                            <td>@msg.Id</td>
                            <td>@msg.SenderName (@msg.SenderId)</td>
                            <td>@msg.Type</td>
                            <td>@msg.Content</td>
                            <td>@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(msg.IsDeleted ? "Да" : "Нет")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<UserDto>? users;
    private List<MessageDto>? messages;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            users = (await ApiService.GetAllUsersAsync()).ToList();
            messages = (await ApiService.GetAllMessagesAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки данных: {ex.Message}");
        }
    }

    private async Task ApproveUser(int userId)
    {
        await ApiService.ApproveUserAsync(userId);
        await LoadData();
    }

    private async Task BlockUser(int userId)
    {
        await ApiService.BlockUserAsync(userId);
        await LoadData();
    }

    private async Task UnblockUser(int userId)
    {
        // API не имеет метода разблокировки, используем одобрение
        await ApiService.ApproveUserAsync(userId);
        await LoadData();
    }

    private async Task DeleteUser(int userId)
    {
        await ApiService.DeleteUserAsync(userId);
        await LoadData();
    }
}
